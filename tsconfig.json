{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "jsxImportSource": "nativewind",
    "strict": true,
    "noUnusedLocals": true,
    "baseUrl": "./",
    "paths": {
      "@components/*": ["src/components/*"],
      "@context/*": ["src/context/*"],
      "@hooks/*": ["src/hooks/*"],
      "@lib/*": ["src/lib/*"],
      "@pages/*": ["src/pages/*"],
      "@queries/*": ["src/queries/*"],
      "@stores/*": ["src/stores/*"],
      "@appTypes/*": ["src/types/*"],
      "@utils/*": ["src/utils/*"],
      "@config/*": ["config/*"],
      "@assets/*": ["assets/*"]
    }
  },
  "include": [
    "tests/**/*",
    "config/**/*",
    "src/**/*",
    "assets/**/*",
    "./*",
    "App.tsx",
    "supabase/**/*",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "**/node_modules/*", "supabase/functions"]
}
