{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-native",
    "jsxImportSource": "nativewind",
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@src/*": [
        "src/*"
      ],
      "@config/*": [
        "config/*"
      ],
      "@assets/*": [
        "assets/*"
      ]
    }
  },
  "include": [
    "tests/**/*",
    "config/**/*",
    "src/**/*",
    "assets/**/*",
    "./*",
    "App.tsx",
    "supabase/**/*",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "supabase/functions"
  ]
}